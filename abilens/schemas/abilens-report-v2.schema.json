{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/abilens/report/v2",
  "title": "AbiLens ELF report",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "valid"
          }
        }
      },
      "then": {
        "properties": {
          "tool": {
            "properties": {
              "name": {
                "const": "abilens"
              },
              "version": {
                "pattern": "^[0-9]+(?:\\.[0-9]+)+$"
              }
            }
          }
        }
      }
    }
  ],
  "required": [
    "schema",
    "input",
    "status",
    "message",
    "tool",
    "elf",
    "dependencies",
    "abi",
    "policy",
    "diagnostics",
    "evidence"
  ],
  "properties": {
    "schema": {
      "const": "abilens.report/v2"
    },
    "input": {
      "type": "string"
    },
    "status": {
      "enum": [
        "valid",
        "non-elf",
        "corrupt",
        "unsupported",
        "unreadable",
        "tool-error"
      ]
    },
    "message": {
      "type": "string"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^(?:$|[0-9]+(?:\\.[0-9]+)+)$"
        }
      }
    },
    "elf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "endian",
        "type",
        "machine",
        "dynamic",
        "stripped"
      ],
      "properties": {
        "class": {
          "type": "string"
        },
        "endian": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "machine": {
          "type": "string"
        },
        "dynamic": {
          "type": "boolean"
        },
        "stripped": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "needed",
        "rpath",
        "runpath"
      ],
      "properties": {
        "needed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "rpath": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runpath": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "abi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versions",
        "maximum"
      ],
      "properties": {
        "versions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespace",
              "version",
              "library"
            ],
            "properties": {
              "namespace": {
                "enum": [
                  "GLIBC",
                  "GLIBCXX",
                  "CXXABI"
                ]
              },
              "version": {
                "pattern": "^[0-9]+(?:\\.[0-9]+)+$"
              },
              "library": {
                "type": "string"
              }
            }
          }
        },
        "maximum": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "GLIBC",
            "GLIBCXX",
            "CXXABI"
          ],
          "properties": {
            "GLIBC": {
              "type": "string",
              "pattern": "^(?:$|[0-9]+(?:\\.[0-9]+)+)$"
            },
            "GLIBCXX": {
              "type": "string",
              "pattern": "^(?:$|[0-9]+(?:\\.[0-9]+)+)$"
            },
            "CXXABI": {
              "type": "string",
              "pattern": "^(?:$|[0-9]+(?:\\.[0-9]+)+)$"
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applied",
        "passed",
        "violations"
      ],
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "passed": {
          "type": "boolean"
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "vtables": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attributes_known",
        "loader_metadata_known",
        "soname",
        "interpreter",
        "build_id",
        "dwarf_status",
        "type_layouts",
        "symbol_evidence",
        "resolutions"
      ],
      "properties": {
        "attributes_known": {
          "type": "boolean"
        },
        "loader_metadata_known": {
          "type": "boolean"
        },
        "soname": {
          "type": "string"
        },
        "interpreter": {
          "type": "string"
        },
        "build_id": {
          "type": "string"
        },
        "dwarf_status": {
          "enum": [
            "not-requested",
            "unavailable",
            "absent",
            "complete",
            "partial",
            "limited",
            "input-changed"
          ]
        },
        "type_layouts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "symbol_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "identity",
              "size",
              "binding",
              "visibility",
              "type",
              "default_version"
            ],
            "properties": {
              "identity": {
                "type": "string"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "binding": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15
              },
              "visibility": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "type": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15
              },
              "default_version": {
                "type": "boolean"
              }
            }
          }
        },
        "resolutions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "needed",
              "status",
              "path",
              "searched"
            ],
            "properties": {
              "needed": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "candidate",
                  "unresolved",
                  "limited"
                ]
              },
              "path": {
                "type": "string"
              },
              "searched": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
