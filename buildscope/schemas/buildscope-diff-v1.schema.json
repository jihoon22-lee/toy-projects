{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jihoon22-lee/toy-projects/buildscope/schemas/buildscope-diff-v1.schema.json",
  "title": "BuildScope semantic configuration diff v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["diagnostics", "inputs", "policy", "producer", "schema_version", "summary", "units"],
  "properties": {
    "diagnostics": {
      "type": "array",
      "maxItems": 100000,
      "items": {"$ref": "#/$defs/diagnostic"}
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["after", "before"],
      "properties": {
        "after": {"$ref": "#/$defs/input"},
        "before": {"$ref": "#/$defs/input"}
      }
    },
    "policy": {"$ref": "#/$defs/policy"},
    "producer": {"$ref": "#/$defs/producer"},
    "schema_version": {"const": "buildscope.diff/v1"},
    "summary": {"$ref": "#/$defs/summary"},
    "units": {
      "type": "array",
      "maxItems": 200000,
      "items": {"$ref": "#/$defs/unit"}
    }
  },
  "$defs": {
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_style", "family", "name", "path", "wrappers"],
      "properties": {
        "command_style": {"enum": ["posix", "windows"]},
        "family": {"enum": ["clang", "clang-cl", "emscripten", "gcc", "msvc", "unknown"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 1048576},
        "path": {"type": "string", "minLength": 1, "maxLength": 1048576},
        "wrappers": {
          "type": "array",
          "maxItems": 32768,
          "items": {"type": "string", "minLength": 1, "maxLength": 1048576}
        }
      }
    },
    "define": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "name", "value"],
      "properties": {
        "action": {"enum": ["define", "undefine"]},
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "value": {"type": "string", "maxLength": 1048576}
      }
    },
    "define_list": {
      "type": "array",
      "maxItems": 32768,
      "items": {"$ref": "#/$defs/define"}
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "severity"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 1048576},
        "message": {"type": "string", "minLength": 1, "maxLength": 1048576},
        "severity": {"enum": ["info", "warning", "error"]},
        "source": {"type": "string", "minLength": 1, "maxLength": 1048576}
      }
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "include": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": {"enum": ["after", "framework", "include", "quote", "system"]},
        "path": {"type": "string", "minLength": 1, "maxLength": 1048576}
      }
    },
    "include_list": {
      "type": "array",
      "maxItems": 32768,
      "items": {"$ref": "#/$defs/include"}
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration_count", "label", "semantic_digest", "source_count"],
      "properties": {
        "configuration_count": {"type": "integer", "minimum": 0, "maximum": 100000},
        "label": {"type": "string", "minLength": 1, "maxLength": 256},
        "semantic_digest": {"$ref": "#/$defs/digest"},
        "source_count": {"type": "integer", "minimum": 0, "maximum": 100000}
      }
    },
    "path_value": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 1048576}
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ignored_fields", "suppression_rules", "version"],
      "properties": {
        "ignored_fields": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "prefixItems": [
            {"const": "raw command spelling"},
            {"const": "compilation directory"},
            {"const": "output path and filename"},
            {"const": "original entry index and duplicate annotation"},
            {"const": "filesystem existence and stale status"},
            {"const": "snapshot diagnostics and include-analysis observations"}
          ],
          "items": false
        },
        "suppression_rules": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/suppression_rule"}
        },
        "version": {"const": "buildscope.diff-policy/v1"}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "buildscope"},
        "version": {"type": "string", "minLength": 1, "maxLength": 1048576}
      }
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiler",
        "defines",
        "flags",
        "include_paths",
        "language",
        "launcher",
        "standard",
        "sysroot",
        "target"
      ],
      "properties": {
        "compiler": {"$ref": "#/$defs/compiler"},
        "defines": {"$ref": "#/$defs/define_list"},
        "flags": {"$ref": "#/$defs/string_list"},
        "include_paths": {"$ref": "#/$defs/include_list"},
        "language": {"enum": ["", "c", "c++", "objective-c", "objective-c++"]},
        "launcher": {"$ref": "#/$defs/string_list"},
        "standard": {"type": "string", "maxLength": 1048576},
        "sysroot": {"type": "string", "maxLength": 1048576},
        "target": {"$ref": "#/$defs/target"}
      }
    },
    "string_list": {
      "type": "array",
      "maxItems": 32768,
      "items": {"type": "string", "maxLength": 1048576}
    },
    "suppression_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "path"],
      "properties": {
        "category": {
          "enum": [
            "*",
            "added",
            "compiler",
            "define",
            "flag",
            "include",
            "language",
            "launcher",
            "moved",
            "removed",
            "standard",
            "sysroot",
            "target"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\\\\\[\\]\\u0000]+$"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "changed",
        "change_count",
        "moved",
        "removed",
        "suppressed_changes",
        "suppressed_units",
        "unchanged",
        "visible_changes",
        "visible_units"
      ],
      "properties": {
        "added": {"type": "integer", "minimum": 0, "maximum": 100000},
        "changed": {"type": "integer", "minimum": 0, "maximum": 100000},
        "change_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "moved": {"type": "integer", "minimum": 0, "maximum": 100000},
        "removed": {"type": "integer", "minimum": 0, "maximum": 100000},
        "suppressed_changes": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "suppressed_units": {"type": "integer", "minimum": 0, "maximum": 200000},
        "unchanged": {"type": "integer", "minimum": 0, "maximum": 100000},
        "visible_changes": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "visible_units": {"type": "integer", "minimum": 0, "maximum": 200000}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build_target", "triple"],
      "properties": {
        "build_target": {"type": "string", "maxLength": 1048576},
        "triple": {"type": "string", "maxLength": 1048576}
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_index", "semantic", "semantic_digest"],
      "properties": {
        "entry_index": {"type": "integer", "minimum": 0, "maximum": 100000},
        "semantic": {"$ref": "#/$defs/semantic"},
        "semantic_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["after", "before", "category", "suppressed", "suppression"],
      "properties": {
        "after": {},
        "before": {},
        "category": {
          "enum": [
            "added",
            "compiler",
            "define",
            "flag",
            "include",
            "language",
            "launcher",
            "moved",
            "removed",
            "standard",
            "sysroot",
            "target"
          ]
        },
        "suppressed": {"type": "boolean"},
        "suppression": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 1024}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"category": {"const": "added"}}},
          "then": {
            "properties": {
              "after": {"$ref": "#/$defs/semantic"},
              "before": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"category": {"const": "compiler"}}},
          "then": {
            "properties": {
              "after": {"$ref": "#/$defs/compiler"},
              "before": {"$ref": "#/$defs/compiler"}
            }
          }
        },
        {
          "if": {"properties": {"category": {"const": "define"}}},
          "then": {
            "properties": {
              "after": {"$ref": "#/$defs/define_list"},
              "before": {"$ref": "#/$defs/define_list"}
            }
          }
        },
        {
          "if": {"properties": {"category": {"const": "flag"}}},
          "then": {
            "properties": {
              "after": {"$ref": "#/$defs/string_list"},
              "before": {"$ref": "#/$defs/string_list"}
            }
          }
        },
        {
          "if": {"properties": {"category": {"const": "include"}}},
          "then": {
            "properties": {
              "after": {"$ref": "#/$defs/include_list"},
              "before": {"$ref": "#/$defs/include_list"}
            }
          }
        },
        {
          "if": {"properties": {"category": {"const": "language"}}},
          "then": {
            "properties": {
              "after": {"type": "string", "maxLength": 1048576},
              "before": {"type": "string", "maxLength": 1048576}
            }
          }
        },
        {
          "if": {"properties": {"category": {"const": "launcher"}}},
          "then": {
            "properties": {
              "after": {"$ref": "#/$defs/string_list"},
              "before": {"$ref": "#/$defs/string_list"}
            }
          }
        },
        {
          "if": {"properties": {"category": {"const": "moved"}}},
          "then": {
            "properties": {
              "after": {"type": "string", "minLength": 1, "maxLength": 1048576},
              "before": {"type": "string", "minLength": 1, "maxLength": 1048576}
            }
          }
        },
        {
          "if": {"properties": {"category": {"const": "removed"}}},
          "then": {
            "properties": {
              "after": {"type": "null"},
              "before": {"$ref": "#/$defs/semantic"}
            }
          }
        },
        {
          "if": {"properties": {"category": {"const": "standard"}}},
          "then": {
            "properties": {
              "after": {"type": "string", "maxLength": 1048576},
              "before": {"type": "string", "maxLength": 1048576}
            }
          }
        },
        {
          "if": {"properties": {"category": {"const": "sysroot"}}},
          "then": {
            "properties": {
              "after": {"type": "string", "maxLength": 1048576},
              "before": {"type": "string", "maxLength": 1048576}
            }
          }
        },
        {
          "if": {"properties": {"category": {"const": "target"}}},
          "then": {
            "properties": {
              "after": {"$ref": "#/$defs/target"},
              "before": {"$ref": "#/$defs/target"}
            }
          }
        }
      ]
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["after", "before", "changes", "kind", "source", "suppressed"],
      "properties": {
        "after": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/view"}
          ]
        },
        "before": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/view"}
          ]
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {"$ref": "#/$defs/change"}
        },
        "kind": {"enum": ["added", "changed", "moved", "removed"]},
        "source": {"$ref": "#/$defs/unit_source"},
        "suppressed": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "added"}}},
          "then": {
            "properties": {
              "after": {"$ref": "#/$defs/view"},
              "before": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "changed"}}},
          "then": {
            "properties": {
              "after": {"$ref": "#/$defs/view"},
              "before": {"$ref": "#/$defs/view"}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "moved"}}},
          "then": {
            "properties": {
              "after": {"$ref": "#/$defs/view"},
              "before": {"$ref": "#/$defs/view"}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "removed"}}},
          "then": {
            "properties": {
              "after": {"type": "null"},
              "before": {"$ref": "#/$defs/view"}
            }
          }
        }
      ]
    },
    "unit_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["after", "before", "style"],
      "properties": {
        "after": {"$ref": "#/$defs/path_value"},
        "before": {"$ref": "#/$defs/path_value"},
        "style": {"enum": ["posix", "windows"]}
      }
    }
  }
}
