{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BuildScope reverse include impact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "header",
    "partial",
    "unavailable_analyses",
    "visited_edges",
    "direct_parents",
    "translation_units",
    "interpretation"
  ],
  "properties": {
    "schema_version": {
      "const": "buildscope.impact/v1"
    },
    "header": {
      "type": "string"
    },
    "partial": {
      "type": "boolean"
    },
    "unavailable_analyses": {
      "type": "integer",
      "minimum": 0
    },
    "visited_edges": {
      "type": "integer",
      "minimum": 0
    },
    "interpretation": {
      "type": "string"
    },
    "direct_parents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "parent",
          "line",
          "source",
          "entry",
          "evidence",
          "location_evidence"
        ],
        "properties": {
          "parent": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 0
          },
          "entry": {
            "type": "integer",
            "minimum": 0
          },
          "evidence": {
            "enum": [
              "estimated",
              "compiler-measured"
            ]
          },
          "location_evidence": {
            "enum": [
              "unavailable",
              "source-scan",
              "compiler-diagnostic"
            ]
          }
        }
      }
    },
    "translation_units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "entry",
          "configuration",
          "evidence",
          "connected",
          "chain"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "entry": {
            "type": "integer",
            "minimum": 0
          },
          "configuration": {
            "type": "string"
          },
          "evidence": {
            "enum": [
              "estimated",
              "compiler-measured",
              "translation-unit"
            ]
          },
          "connected": {
            "type": "boolean"
          },
          "chain": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
