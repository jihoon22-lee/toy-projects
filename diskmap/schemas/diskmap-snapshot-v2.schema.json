{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "diskmap.snapshot/v2"
    },
    "complete": {
      "type": "boolean"
    },
    "truncated": {
      "type": "boolean"
    },
    "node_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "root": {
      "$ref": "#/$defs/node"
    }
  },
  "required": [
    "schema_version",
    "complete",
    "truncated",
    "node_count",
    "root"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiskMap snapshot v2",
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "allocated_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "reclaimable_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "allocated_size_known": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean"
        },
        "cycle_skipped": {
          "type": "boolean"
        },
        "followed": {
          "type": "boolean"
        },
        "has_target_metadata": {
          "type": "boolean"
        },
        "is_dir": {
          "type": "boolean"
        },
        "logical_size_known": {
          "type": "boolean"
        },
        "mount_boundary_skipped": {
          "type": "boolean"
        },
        "reclaimable_size_known": {
          "type": "boolean"
        },
        "error": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "target_metadata": {
          "$ref": "#/$defs/metadata"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "name_bytes": {
          "type": "string",
          "pattern": "^(?:0[1-9a-f]|[1-9a-f][0-9a-f])*$"
        },
        "path_bytes": {
          "type": "string",
          "pattern": "^(?:0[1-9a-f]|[1-9a-f][0-9a-f])*$"
        }
      },
      "required": [
        "allocated_size",
        "reclaimable_size",
        "size",
        "allocated_size_known",
        "complete",
        "cycle_skipped",
        "followed",
        "has_target_metadata",
        "is_dir",
        "logical_size_known",
        "mount_boundary_skipped",
        "reclaimable_size_known",
        "error",
        "name",
        "path",
        "metadata",
        "target_metadata",
        "children",
        "name_bytes",
        "path_bytes"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "allocated_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "group": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "hard_link_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "logical_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "owner": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "permissions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "allocated_size_known": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean"
        },
        "hard_link_count_known": {
          "type": "boolean"
        },
        "modified_time_known": {
          "type": "boolean"
        },
        "ownership_known": {
          "type": "boolean"
        },
        "permissions_known": {
          "type": "boolean"
        },
        "error": {
          "type": "string"
        },
        "identity": {
          "type": "object",
          "properties": {
            "device": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "file": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "valid": {
              "type": "boolean"
            }
          },
          "required": [
            "device",
            "file",
            "valid"
          ],
          "additionalProperties": false
        },
        "kind": {
          "enum": [
            "regular_file",
            "directory",
            "symlink",
            "other"
          ]
        },
        "modified_ns": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "changed_ns": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "changed_time_known": {
          "type": "boolean"
        }
      },
      "required": [
        "allocated_size",
        "group",
        "hard_link_count",
        "logical_size",
        "owner",
        "permissions",
        "allocated_size_known",
        "complete",
        "hard_link_count_known",
        "modified_time_known",
        "ownership_known",
        "permissions_known",
        "error",
        "identity",
        "kind",
        "modified_ns",
        "changed_ns",
        "changed_time_known"
      ],
      "additionalProperties": false
    }
  }
}
