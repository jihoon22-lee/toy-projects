{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "loglens.saved-queries/v1"
    },
    "queries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "expression": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "name",
          "expression"
        ],
        "additionalProperties": false
      },
      "maxItems": 128
    }
  },
  "required": [
    "schema",
    "queries"
  ],
  "additionalProperties": false
}
