{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "loglens.session/v2"
    },
    "name": {
      "type": "string",
      "maxLength": 128
    },
    "filter": {
      "type": "string",
      "maxLength": 4096
    },
    "level": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "format": {
          "enum": [
            "auto",
            "iso",
            "syslog",
            "jsonl",
            "raw"
          ]
        },
        "multiline": {
          "enum": [
            "fold-continuations",
            "separate-lines"
          ]
        },
        "max_record_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "format_plugin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "identity": {
          "type": "string",
          "maxLength": 128
        },
        "modified": {
          "type": "string",
          "maxLength": 128
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^(|[a-f0-9]{64})$"
        },
        "fingerprint_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "plugin_fingerprint": {
          "type": "string",
          "pattern": "^(|[a-f0-9]{64})$"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "properties": {
        "search": {
          "type": "string",
          "maxLength": 4096
        },
        "whole_file_search": {
          "type": "string",
          "maxLength": 4096
        },
        "investigation_tab": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "settings_open": {
          "type": "boolean"
        },
        "follow": {
          "type": "boolean"
        },
        "tail_mode": {
          "type": "boolean"
        },
        "tail_records": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "selected": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "begin_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                "end_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                }
              },
              "required": [
                "begin_ms",
                "end_ms"
              ],
              "additionalProperties": false
            }
          ]
        },
        "baseline": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "begin_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                "end_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                }
              },
              "required": [
                "begin_ms",
                "end_ms"
              ],
              "additionalProperties": false
            }
          ]
        },
        "comparison": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "begin_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                "end_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                }
              },
              "required": [
                "begin_ms",
                "end_ms"
              ],
              "additionalProperties": false
            }
          ]
        },
        "layout": {
          "type": "string",
          "maxLength": 65536
        },
        "geometry": {
          "type": "string",
          "maxLength": 65536
        },
        "table_header": {
          "type": "string",
          "maxLength": 65536
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "triage": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "schema": {
              "const": "loglens.triage/v1"
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "pattern": {
                    "type": "string",
                    "maxLength": 1024
                  },
                  "whole_line": {
                    "type": "boolean"
                  },
                  "priority": {
                    "type": "integer"
                  },
                  "style": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                },
                "required": [
                  "name",
                  "pattern",
                  "whole_line",
                  "priority",
                  "style"
                ],
                "additionalProperties": false
              },
              "maxItems": 128
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source_path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "line_number": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "bookmarked": {
                    "type": "boolean"
                  },
                  "annotation": {
                    "type": "string",
                    "maxLength": 4096
                  }
                },
                "required": [
                  "source_path",
                  "line_number",
                  "bookmarked",
                  "annotation"
                ],
                "additionalProperties": false
              },
              "maxItems": 8192
            }
          },
          "required": [
            "schema",
            "rules",
            "entries"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schema": {
              "const": "loglens.triage/v2"
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "pattern": {
                    "type": "string",
                    "maxLength": 1024
                  },
                  "whole_line": {
                    "type": "boolean"
                  },
                  "priority": {
                    "type": "integer"
                  },
                  "style": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                },
                "required": [
                  "name",
                  "pattern",
                  "whole_line",
                  "priority",
                  "style"
                ],
                "additionalProperties": false
              },
              "maxItems": 128
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source_path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "line_number": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "bookmarked": {
                    "type": "boolean"
                  },
                  "annotation": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "source_identity": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "generation": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                  },
                  "record_fingerprint": {
                    "type": "string",
                    "pattern": "^(|[a-f0-9]{64})$"
                  }
                },
                "required": [
                  "source_path",
                  "line_number",
                  "bookmarked",
                  "annotation",
                  "source_identity",
                  "generation",
                  "record_fingerprint"
                ],
                "additionalProperties": false
              },
              "maxItems": 8192
            }
          },
          "required": [
            "schema",
            "rules",
            "entries"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema",
    "source"
  ],
  "additionalProperties": false
}
