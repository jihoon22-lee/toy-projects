{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "loglens.source-profiles/v1"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "format": {
            "enum": [
              "auto",
              "iso",
              "syslog",
              "jsonl",
              "raw"
            ]
          },
          "multiline": {
            "enum": [
              "fold-continuations",
              "separate-lines"
            ]
          },
          "max_record_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          }
        },
        "required": [
          "name",
          "format",
          "multiline",
          "max_record_bytes"
        ],
        "additionalProperties": false
      },
      "maxItems": 128
    }
  },
  "required": [
    "schema",
    "profiles"
  ],
  "additionalProperties": false
}
