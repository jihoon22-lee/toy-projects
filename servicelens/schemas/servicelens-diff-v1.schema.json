{
  "type": "object",
  "properties": {
    "schema": {
      "const": "servicelens.diff/v1"
    },
    "changed": {
      "type": "boolean"
    },
    "unknown": {
      "type": "boolean"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "unit": {
            "type": "string",
            "maxLength": 65536
          },
          "key": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 65536
          },
          "kind": {
            "type": "string",
            "enum": [
              "added",
              "removed",
              "value-changed",
              "origin-changed",
              "evidence-changed",
              "structure-changed",
              "diagnostics-changed"
            ]
          },
          "before": {},
          "after": {}
        },
        "required": [
          "unit",
          "key",
          "kind",
          "before",
          "after"
        ],
        "additionalProperties": false
      },
      "maxItems": 100000
    },
    "uncertain": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "unit": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 65536
          },
          "key": {
            "type": "string",
            "maxLength": 65536
          },
          "reason": {
            "type": "string",
            "maxLength": 65536
          }
        },
        "required": [
          "unit",
          "key",
          "reason"
        ],
        "additionalProperties": false
      },
      "maxItems": 100000
    }
  },
  "required": [
    "schema",
    "changed",
    "unknown",
    "changes",
    "uncertain"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServiceLens diff v1"
}
