      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observed_shards": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manifest_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
