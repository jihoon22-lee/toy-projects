{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tracelens:events-end-v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "tracelens.events-end/v1"
    },
    "events": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "description": "Unsigned 64-bit integer encoded as a decimal string."
    },
    "matching": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "description": "Unsigned 64-bit integer encoded as a decimal string."
    },
    "emitted": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "description": "Unsigned 64-bit integer encoded as a decimal string."
    },
    "output_truncated": {
      "type": "boolean"
    },
    "partial": {
      "type": "boolean"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "device": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "description": "Unsigned 64-bit integer encoded as a decimal string."
          },
          "inode": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "description": "Unsigned 64-bit integer encoded as a decimal string."
          },
          "modified_ns": {
            "type": "string"
          },
          "size": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "description": "Unsigned 64-bit integer encoded as a decimal string."
          },
          "scanned_bytes": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "description": "Unsigned 64-bit integer encoded as a decimal string."
          },
          "lines": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "description": "Unsigned 64-bit integer encoded as a decimal string."
          },
          "changed": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "sha256",
          "device",
          "inode",
          "modified_ns",
          "size",
          "scanned_bytes",
          "lines",
          "changed"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "events",
    "matching",
    "emitted",
    "output_truncated",
    "partial",
    "reasons",
    "sources"
  ],
  "additionalProperties": false
}
